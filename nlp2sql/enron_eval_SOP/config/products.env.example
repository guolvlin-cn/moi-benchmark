# 复制为本机私有文件后填写。不要把真实账号、密码或API Key提交到Git。

# 三个产品统一使用这一模型快照。
export ENRON_EVAL_MODEL='qwen3.7-plus-2026-05-26'

# MOI本地部署。仅运行MOI时需要账号和密码。
export MOI_EMAIL='your-local-account@example.com'
export MOI_PASSWORD='replace_with_your_local_password'
export MOI_BASE_URL='http://localhost:18002'
export MOI_UC_URL='http://127.0.0.1:19080'
export MOI_WORKSPACE_ID='replace_with_your_workspace_id'

# DashScope Key写入各产品自己的私有配置，不由批量脚本保存。
export DASHSCOPE_API_KEY='replace_with_your_private_key'

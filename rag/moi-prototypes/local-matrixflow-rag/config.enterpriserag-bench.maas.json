{
  "matrixone": {
    "dsn": "root:111@tcp(127.0.0.1:6001)/",
    "database": "moi_stage1_enterpriserag_bench",
    "vector_table": "embedding_results",
    "skip_exhaustive_file_id_filter": true
  },
  "workspace_id": "moi-stage1-enterpriserag-bench",
  "matrixflow_root": "../../../../matrixflow",
  "chunk_size": 512,
  "chunk_overlap": 50,
  "section_size": 5,
  "embedding_batch_size": 1024,
  "embedding_concurrency": 4,
  "insert_batch_size": 50,
  "embedding": {
    "mode": "maas",
    "base_url": "https://api.modelarts-maas.com/v1",
    "model": "bge-m3",
    "api_key_env": "MAAS_API_KEY",
    "dimension": 1024,
    "timeout_seconds": 600,
    "retry_max_attempts": 4,
    "retry_backoff_seconds": 5
  },
  "generation": {
    "enabled": false
  }

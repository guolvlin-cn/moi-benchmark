# Copy this file to /Users/muuushroom/gitrepos/moi-benchmark/rag/.env.
# Never commit the real token.
MINERU_API_TOKEN=replace-with-token-created-in-mineru-api-console

# Local MatrixFlow OpenXML parser (DOCX/PPTX/XLSX)
OPENXML_BASE_URL=http://127.0.0.1:8080
SOFFICE_BIN=/absolute/path/to/soffice
MOI_DOCX_GEOMETRY_ALIGNER=/absolute/path/to/docx-geometry-aligner

# MatrixOrigin TaaS OpenAI-compatible multimodal endpoint
TAAS_BASE_URL=https://token.moi.matrixorigin.cn/v1
TAAS_VL_MODEL=qwen3-vl-plus
TAAS_API_KEY=replace-with-taas-api-key

# Huawei Cloud MaaS (CN Southwest-Guiyang-1, OpenAI-compatible V1 APIs).
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_API_KEY=replace-with-huawei-maas-api-key
MAAS_LLM_MODEL=deepseek-v4-flash
MAAS_VL_MODEL=qwen2.5-vl-72b
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=bge-reranker-v2-m3

# DeepSeek official OpenAI-compatible API (generation only; embeddings remain MaaS BGE-M3).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Local RAG competitor entry point. All competitor API keys/app IDs/chat IDs
# belong in this repository-root .env; do not put real values in component
# runtime.env files or checked-in examples.
# ---------------------------------------------------------------------------

# MOI / MatrixFlow API
MOI_API_URL=http://127.0.0.1:8000
MOI_API_KEY=replace-with-moi-api-key
MOI_BENCHMARK_EMPTY_PATH=

# Dify local app/dataset
DIFY_API_BASE_URL=http://127.0.0.1:8010/v1
DIFY_API_KEY=replace-with-dify-app-api-key
DIFY_DATASET_API_KEY=replace-with-dify-dataset-api-key
DIFY_LOCAL_API_KEY=replace-with-dify-local-app-api-key
DIFY_LOCAL_APP_ID=replace-with-dify-local-app-id
DIFY_LOCAL_DATASET_API_KEY=replace-with-dify-local-dataset-api-key
DIFY_LOCAL_DATASET_ID=replace-with-dify-local-dataset-id
DIFY_LOCAL_ADMIN_EMAIL=
DIFY_LOCAL_ADMIN_NAME=
DIFY_LOCAL_ADMIN_PASSWORD=
DIFY_BENCHMARK_INPUTS_JSON={}
DIFY_BENCHMARK_EMPTY_INPUTS_JSON={}

# FastGPT local app
FASTGPT_BASE_URL=http://127.0.0.1:3000
FASTGPT_API_KEY=replace-with-fastgpt-api-key
FASTGPT_APP_ID=replace-with-fastgpt-app-id
FASTGPT_MODEL_PROVIDER=taas

# MaxKB local application
MAXKB_BASE_URL=http://127.0.0.1:8090
MAXKB_API_KEY=replace-with-maxkb-application-api-key
MAXKB_APPLICATION_ID=replace-with-maxkb-application-id
MAXKB_APP_ID=replace-with-maxkb-application-id
MAXKB_OPENAI_BASE_URL=http://127.0.0.1:8090/chat/api
MAXKB_OPENAI_PATH=/chat/completions

# RAGFlow local chat API
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=replace-with-ragflow-api-key
RAGFLOW_CHAT_ID=replace-with-ragflow-chat-id

# Shared external provider keys used by local products and evaluators.
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=replace-with-qianfan-api-key
QIANFAN_APPID=
QIANFAN_LLM_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b

# Optional local smoke defaults; these are not credentials.
FASTGPT_SMOKE_SOURCE_DIR=local-rag-platforms/fixtures/smoke
FASTGPT_SMOKE_WAIT_SECONDS=300
FASTGPT_SMOKE_QUESTION=What facts are stated in the local smoke documents?
FASTGPT_SMOKE_RETRIEVAL_QUERY=local RAG smoke

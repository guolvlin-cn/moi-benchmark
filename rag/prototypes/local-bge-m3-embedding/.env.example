# The official FlagEmbedding model identifier. The first embedding request
# downloads it from Hugging Face unless BGE_MODEL_DIR points to a local copy.
BGE_MODEL=BAAI/bge-m3
BGE_MODEL_ID=BAAI/bge-m3
# BGE_MODEL_DIR=/absolute/path/to/BAAI--bge-m3
# BGE_CACHE_DIR=/absolute/path/to/huggingface-cache

# auto selects CUDA, Apple MPS, or CPU. On a Mac, set cpu if MPS is unstable.
BGE_DEVICE=auto
# Leave empty for the safe default: fp16 only on CUDA.
BGE_USE_FP16=
BGE_BATCH_SIZE=8
BGE_MAX_LENGTH=8192
BGE_MAX_BATCH=64
BGE_MAX_BATCH_BYTES=262144
BGE_DIMENSION=1024

BGE_HOST=127.0.0.1
BGE_PORT=8081
# Lazy loading keeps startup fast; the first /embeddings request loads weights.
BGE_LAZY_LOAD=true
# Set true when BGE_MODEL_DIR is a complete local snapshot and network access
# must be disabled.
BGE_LOCAL_FILES_ONLY=false

# Optional loopback-service authentication. Leave empty for a localhost-only
# service; if set, clients must send Authorization: Bearer <value>.
# BGE_API_KEY=replace-with-a-local-secret

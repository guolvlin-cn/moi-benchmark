# Copy to .local-services/fastgpt_local/fastgpt.env and fill locally.
# Never commit the populated file.
FASTGPT_BASE_URL=http://127.0.0.1:3000
FASTGPT_API_KEY=<local-fastgpt-api-key>
FASTGPT_APP_ID=<local-fastgpt-app-id>

# MatrixOrigin TaaS is external model egress, not a fully-offline deployment.
TAAS_BASE_URL=https://api-taas.moi.matrixorigin.cn/v1
TAAS_API_KEY=<matrixorigin-taas-api-key>
TAAS_CHANNEL_NAME='MatrixOrigin TaaS'
TAAS_LLM_MODEL=qwen3.6-flash
TAAS_EMBEDDING_MODEL=bge-m3

# Baidu Qianfan V2 fallback channel. Use a Qianfan API Key, not BCE AK/SK.
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=<baidu-qianfan-v2-api-key>
QIANFAN_CHANNEL_NAME='Baidu Qianfan V2'
QIANFAN_LLM_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b
QIANFAN_APPID=

# Smoke defaults. Keep the source directory read-only.
FASTGPT_SMOKE_SOURCE_DIR=local-rag-platforms/fixtures/smoke
FASTGPT_SMOKE_QUESTION='What facts are stated in the local smoke documents?'
FASTGPT_SMOKE_RETRIEVAL_QUERY='local RAG smoke'
FASTGPT_SMOKE_WAIT_SECONDS=300

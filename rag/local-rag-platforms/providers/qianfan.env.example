# Baidu Qianfan ModelBuilder V2 OpenAI-compatible API.
# Copy the needed values into each platform's ignored runtime env file.
# Never commit a populated API key.
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=<baidu-qianfan-v2-api-key>
QIANFAN_CHANNEL_NAME='Baidu Qianfan V2'
QIANFAN_LLM_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_EMBEDDING_BATCH_SIZE=16
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b
QIANFAN_APPID=

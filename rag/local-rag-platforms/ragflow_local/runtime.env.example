# Copy to .local-services/ragflow_local/compose/runtime.env. Do not commit real secrets.
RAGFLOW_HTTP_PORT=9380
RAGFLOW_ADMIN_PORT=9381
ELASTIC_PASSWORD=infini_rag_flow
MYSQL_PASSWORD=infini_rag_flow
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow
REDIS_PASSWORD=infini_rag_flow

# Constrained local variant: upstream defaults to 8073741824 bytes for ES.
ES_MEM_LIMIT=4294967296
DOC_BULK_SIZE=1
EMBEDDING_BATCH_SIZE=4

# TaaS is configured after first login in Model providers > OpenAI.
# Keep these names here as an operator checklist; Compose does not consume them.
TAAS_BASE_URL=
TAAS_API_KEY=
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_API_KEY=
MAAS_CHAT_MODEL=qwen3-30b-a3b
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=bge-reranker-v2-m3
TAAS_CHAT_MODEL=
TAAS_EMBEDDING_MODEL=

# Qianfan is also configured after first login under Model providers > OpenAI.
# Compose does not consume these values directly.
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=
QIANFAN_CHAT_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b
QIANFAN_APPID=

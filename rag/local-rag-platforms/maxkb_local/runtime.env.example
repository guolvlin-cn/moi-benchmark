# Copy to .local-services/maxkb_local/runtime.env and chmod 600.
# Never commit or paste real credentials into reports/artifacts.
TAAS_BASE_URL=https://api-taas.moi.matrixorigin.cn/v1
TAAS_API_KEY=<existing-taas-secret>
TAAS_CHAT_MODEL=<existing-chat-model>
TAAS_EMBEDDING_MODEL=bge-m3

# Independent Baidu Qianfan V2 provider records; do not replace the TaaS rows.
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=<baidu-qianfan-v2-api-key>
QIANFAN_CHAT_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b
QIANFAN_APPID=

# Rotate the official initial password in the UI; this placeholder is optional.
MAXKB_ADMIN_NEW_PASSWORD=<local-password-manager-value>

# Copy the published agent's values from its API documentation.
MAXKB_APP_ID=<local-application-id>
MAXKB_API_KEY=<local-application-key>
MAXKB_OPENAI_BASE_URL=http://127.0.0.1:8090/<instance-provided-base-without-chat-completions>
MAXKB_OPENAI_PATH=/chat/completions

# Copy to .local-services/maxkb_local/runtime.env and chmod 600.
# Never commit or paste real credentials into reports/artifacts. API keys are
# centralized in the repository-root .env.
TAAS_BASE_URL=https://token.moi.matrixorigin.cn/v1
# TAAS_API_KEY lives in the root .env.
TAAS_CHAT_MODEL=<existing-chat-model>
TAAS_EMBEDDING_MODEL=bge-m3

# Independent Baidu Qianfan V2 provider records; do not replace the TaaS rows.
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
# MAAS_API_KEY lives in the root .env.
MAAS_CHAT_MODEL=qwen3-30b-a3b
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=bge-reranker-v2-m3

QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
# QIANFAN_API_KEY lives in the root .env.
QIANFAN_CHAT_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b
QIANFAN_APPID=

# MaxKB evaluation selection. The embedding model record is created/verified
# by: maxkb-local.sh qianfan-embedding register --execute
MAXKB_BASE_URL=http://127.0.0.1:8090
MAXKB_ADMIN_BASE_URL=http://127.0.0.1:8090/admin/api
MAXKB_ADMIN_TOKEN_FILE=.local-services/maxkb_local/secrets/admin.token
MAXKB_EMBEDDING_PROVIDER=qianfan
MAXKB_EMBEDDING_MODEL_NAME=qwen3-embedding-8b
MAXKB_EMBEDDING_DIMENSION=4096
# Optional after registration; competitor_eval_runner can discover by name.
MAXKB_EMBEDDING_MODEL_ID=

# Rotate the official initial password in the UI; this placeholder is optional.
MAXKB_ADMIN_NEW_PASSWORD=<local-password-manager-value>

# Copy the published agent's values from its API documentation.
MAXKB_APP_ID=<local-application-id>
# MAXKB_API_KEY lives in the root .env.
MAXKB_OPENAI_BASE_URL=http://127.0.0.1:8090/<instance-provided-base-without-chat-completions>
MAXKB_OPENAI_PATH=/chat/completions

# Local Dify application credentials.
DIFY_API_BASE_URL=http://127.0.0.1:8010/v1
# DIFY_LOCAL_DATASET_API_KEY and DIFY_LOCAL_API_KEY live in the root .env.
DIFY_LOCAL_APP_ID=<local-app-id>
DIFY_LOCAL_DATASET_ID=<local-dataset-id>

# Optional Baidu Qianfan V2 provider. Register these values in Dify's local
# OpenAI-compatible model provider after the stack is running.
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
# QIANFAN_API_KEY lives in the root .env.
QIANFAN_LLM_MODEL=deepseek-v4-flash
QIANFAN_EMBEDDING_MODEL=qwen3-embedding-8b
QIANFAN_EMBEDDING_DIMENSION=4096
QIANFAN_RERANKER_MODEL=qwen3-reranker-8b
QIANFAN_APPID=
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
# MAAS_API_KEY lives in the root .env.
MAAS_LLM_MODEL=qwen3-30b-a3b
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=bge-reranker-v2-m3
DIFY_MAAS_EMBEDDING_PROVIDER=matrixorigin/matrixorigin_taas/huawei_maas

    {
      "id": "0530af0c-67b3-487e-9b7b-ade50ff19ef1",
      "index": 96,
      "type": "text",
      "level": null,
      "content": "SMIC document security levels are categorized accounting to the security control level’s defined in “CR-GWNL-01-1001 SMIC Classified Information Protection Policy (CIPP)”as follows",
      "page_num": 1
    },
    {
      "id": "8a64f2c2-a681-4e6a-aa7c-975e14235ba5",
      "index": 97,
      "type": "text",
      "level": null,

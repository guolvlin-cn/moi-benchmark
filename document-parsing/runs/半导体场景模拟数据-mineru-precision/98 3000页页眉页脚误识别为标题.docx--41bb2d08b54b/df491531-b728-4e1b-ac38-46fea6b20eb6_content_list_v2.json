                        ]
                    },
                    {
                        "item_type": "text",
                        "ilevel": 0,
                        "prefix": "-",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "A system-level diagnostic data module or namespace used for equipment health monitoring, fault diagnosis, and maintenance analysis, rather than for process or recipe control."

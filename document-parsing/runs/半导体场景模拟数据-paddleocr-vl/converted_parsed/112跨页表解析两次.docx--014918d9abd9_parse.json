      "type": "table",
      "level": null,
      "content": "<table><tr><td>No.</td><td>英文单字</td><td></td><td>中文批注</td><td>说明</td></tr><tr><td>1.</td><td>data</td><td></td><td>数据</td><td>用于分析、计算或建模的原始信息</td></tr><tr><td>2.</td><td>model</td><td></td><td>模型</td><td>对现实问题的数学或逻辑抽象</td></tr><tr><td>3.</td><td>signal</td><td></td><td>信号</td><td>随时间或空间变化的物理量</td></tr><tr><td>4.</td><td>noise</td><td></td><td>噪声</td><td>干扰有效信号的随机成分</td></tr><tr><td>5.</td><td>peak</td><td></td><td>峰</td><td>数据或谱线中的局部最大值</td></tr><tr><td>6.</td><td>width</td><td></td><td>宽度</td><td>描述峰或分布的展宽程度</td></tr><tr><td>7.</td><td>energy</td><td></td><td>能量</td><td>物理系统中的基本量</td></tr><tr><td>8.</td><td>channel</td><td></td><td>道址</td><td>能谱中对应的离散编号</td></tr><tr><td>9.</td><td>count</td><td></td><td>计数</td><td>探测器记录到的事件数量</td></tr><tr><td>10.</td><td>spectrum</td><td></td><td>能谱</td><td>能量分布的统计结果</td></tr><tr><td>11.</td><td>background</td><td></td><td>本底</td><td>非目标信号产生的背景计数</td></tr><tr><td>12.</td><td>calibration</td><td></td><td>标定</td><td>将测量值映射到真实物理量</td></tr><tr><td>13.</td><td>resolution</td><td></td><td>分辨率</td><td>区分相邻峰的能力</td></tr><tr><td>14.</td><td>algorithm</td><td></td><td>算法</td><td>解决问题的计算步骤集合</td></tr><tr><td>15.</td><td>iteration</td><td></td><td>迭代</td><td>重复执行计算以逼近结果</td></tr><tr><td>16.</td><td>convergence</td><td></td><td>收敛</td><td>迭代结果趋于稳定的过程</td></tr><tr><td>17.</td><td>threshold</td><td></td><td>阈值</td><td>用于判断或筛选的界限值</td></tr><tr><td>18.</td><td>region</td><td></td><td>区域</td><td>数据分析中的选定范围</td></tr><tr><td>19.</td><td>matrix</td><td></td><td>矩阵</td><td>用于线性运算的二维数组</td></tr><tr><td>20.</td><td>vector</td><td></td><td>向量</td><td>具有方向和大小的数据结构</td></tr><tr><td>21.</td><td>ESD 效应</td><td></td><td>静电效应</td><td>静电放电（ESD）是由于物体之间存在静电场的描述</td></tr></table>",
